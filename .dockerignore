# ============================================================================
# Docker Ignore File
# Excludes files from Docker build context to reduce image size
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
venv_bot/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files (use docker secrets instead)
.env
.env.*
!.env.example
*.env.backup
.env.encrypted
.env.bak.*
.env.broken

# Encryption keys
*.key
encryption.key
secrets.key

# SSH keys
pass
pass.pub
*.pem
id_rsa*
id_ed25519*

# Data directories (mount as volumes)
data/
chroma_db/
chroma_data/
/memory/
memory/
*.db
*.sqlite
*.sqlite3
*.bin

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.backup
*.backup-*
*.pre-*
*.old
*.bak.*

# Documentation (optional - remove if you want docs in container)
# docs/

# CI/CD
.github/

# Development files
*.md
!README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# Grafana and monitoring configs (handled separately)
grafana/
prometheus.yml

# Deprecated files
IMPLEMENTATION_*.md
SESSION_SUMMARY.md
PERSONA_CLEANUP_SUMMARY.md

# Build artifacts
0
status
=*

# Large files that shouldn't be in the image
*.tar
*.tar.gz
*.zip
*.7z
