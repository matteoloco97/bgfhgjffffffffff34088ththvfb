# ============================================================================
# Telegram Bot Streaming Configuration Example
# ============================================================================
# Add these to your existing .env file to enable streaming responses
# in your Telegram bot

# -----------------------------------------------------------------------------
# Streaming Configuration
# -----------------------------------------------------------------------------

# Enable progressive message updates (SSE streaming)
# Set to 1 to enable, 0 to disable
# When enabled, bot shows responses appearing word-by-word in real-time
TELEGRAM_STREAMING_ENABLED=1

# Backend streaming endpoint URL
# Default uses the standard /chat/stream endpoint on port 8081
QUANTUM_CHAT_STREAM_URL=http://127.0.0.1:8081/chat/stream

# -----------------------------------------------------------------------------
# How Streaming Works
# -----------------------------------------------------------------------------
# When streaming is enabled:
# 1. Bot sends initial "🤔 Thinking..." message
# 2. Shows typing indicator during thinking phase
# 3. Message updates progressively as tokens arrive
# 4. Smart batching prevents Telegram rate limits:
#    - Updates every 500ms minimum
#    - OR every 50 tokens (whichever comes first)
# 5. Falls back to non-streaming on any error

# Users can control streaming per-chat:
# - /streaming       - Check current status
# - /streaming on    - Enable progressive updates
# - /streaming off   - Disable (single complete message)

# -----------------------------------------------------------------------------
# Existing Telegram Configuration (Required)
# -----------------------------------------------------------------------------

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram admin chat ID (optional, for admin commands)
# Find your chat ID by sending /start to @userinfobot
TELEGRAM_ADMIN_ID=your_chat_id_here

# UI preferences (optional)
TELEGRAM_SOURCE_PREVIEW=0        # Show URL previews in messages
TELEGRAM_SHOW_SOURCES=1          # Show source links in responses
TELEGRAM_SHOW_CACHE_BADGE=1      # Show "(da cache)" badge

# -----------------------------------------------------------------------------
# Backend Configuration (Required)
# -----------------------------------------------------------------------------

# Main chat endpoint (fallback when streaming fails)
QUANTUM_CHAT_URL=http://127.0.0.1:8081/chat

# Unified orchestrator endpoint (preferred)
QUANTUM_UNIFIED_URL=http://127.0.0.1:8081/unified

# Web search endpoints
QUANTUM_WEB_SEARCH_URL=http://127.0.0.1:8081/web/search
QUANTUM_WEB_SUMMARY_URL=http://127.0.0.1:8081/web/summarize
QUANTUM_WEB_RESEARCH_URL=http://127.0.0.1:8081/web/research

# System endpoints
QUANTUM_HEALTH_URL=http://127.0.0.1:8081/healthz
QUANTUM_SYSTEM_STATUS_URL=http://127.0.0.1:8081/system/status
QUANTUM_AUTOBUG_URL=http://127.0.0.1:8081/autobug/run

# Tool endpoints
QUANTUM_MATH_URL=http://127.0.0.1:8081/tools/math
QUANTUM_PYTHON_URL=http://127.0.0.1:8081/tools/python

# Persona endpoints
QUANTUM_PERSONA_SET_URL=http://127.0.0.1:8081/persona/set
QUANTUM_PERSONA_GET_URL=http://127.0.0.1:8081/persona/get
QUANTUM_PERSONA_RESET_URL=http://127.0.0.1:8081/persona/reset

# -----------------------------------------------------------------------------
# Performance Notes
# -----------------------------------------------------------------------------
# Streaming provides better UX:
# - User sees response appearing in real-time
# - Feels faster (first tokens arrive quickly)
# - More engaging for long responses
#
# Batching protects against rate limits:
# - Telegram allows ~30 edits/second per chat
# - Our 500ms minimum = max 2 edits/second (very safe)
# - Token batching reduces unnecessary updates
#
# Fallback ensures reliability:
# - If streaming fails, falls back to /chat
# - Users get response either way
# - No degradation in functionality

# -----------------------------------------------------------------------------
# Recommended Settings
# -----------------------------------------------------------------------------
# Development/Testing:
#   TELEGRAM_STREAMING_ENABLED=1  # Test streaming behavior
#
# Production (recommended):
#   TELEGRAM_STREAMING_ENABLED=1  # Enable for better UX
#
# Production (conservative, if issues):
#   TELEGRAM_STREAMING_ENABLED=0  # Disable streaming, use traditional responses
