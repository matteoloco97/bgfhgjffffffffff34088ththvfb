# ============================================================================
# SEARCH ENGINE (WEB-02) - Multi-Provider Search Configuration
# ============================================================================
# Add these to your existing .env file to configure the search engine
# This enables multi-provider search with A→B→C fallback, multilingual
# query expansion, and trust-based scoring.

# -----------------------------------------------------------------------------
# Provider Configuration
# -----------------------------------------------------------------------------
# Primary search provider (first choice)
# Supported values: brave, bing, searxng
SEARCH_PROVIDER_PRIMARY=brave

# Secondary search provider (fallback when primary fails or returns few results)
SEARCH_PROVIDER_SECONDARY=bing

# Tertiary search provider (last resort fallback)
SEARCH_PROVIDER_TERTIARY=searxng

# -----------------------------------------------------------------------------
# Provider API Keys (set the ones you use)
# -----------------------------------------------------------------------------
# Brave Search API key (get from https://brave.com/search/api/)
# BRAVE_API_KEY=your-brave-api-key-here

# Bing Web Search API key (get from Azure Cognitive Services)
# BING_API_KEY=your-bing-api-key-here

# SearXNG instance URL (self-hosted metasearch engine)
# SEARXNG_URL=http://127.0.0.1:8888

# -----------------------------------------------------------------------------
# Search Parameters
# -----------------------------------------------------------------------------
# Comma-separated list of language codes for query expansion
# Default expands queries in Italian and English for better coverage
SEARCH_LANGS=it,en

# Maximum results to return from search engine
SEARCH_MAX_RESULTS=12

# Timeout for each provider request in seconds
SEARCH_TIMEOUT=10

# Minimum results before trying fallback provider
# If provider A returns fewer than this, try provider B
SEARCH_MIN_RESULTS_BEFORE_FALLBACK=4

# -----------------------------------------------------------------------------
# Provider Enable/Disable Flags
# -----------------------------------------------------------------------------
# Enable Brave Search (requires BRAVE_API_KEY)
BRAVE_SEARCH_ENABLED=1

# Enable Bing Search (requires BING_API_KEY)
BING_SEARCH_ENABLED=1

# Enable SearXNG Search (requires SEARXNG_URL)
SEARXNG_ENABLED=1

# -----------------------------------------------------------------------------
# How it works:
# -----------------------------------------------------------------------------
# 1. Query Expansion:
#    - If SEARCH_LANGS=it,en, the query "prezzo bitcoin" will be searched as:
#      - Italian: "prezzo bitcoin"
#      - English: "price bitcoin" (auto-translated key terms)
#    - Results from both languages are merged and deduplicated
#
# 2. Provider Fallback:
#    - First tries SEARCH_PROVIDER_PRIMARY (e.g., Brave)
#    - If error/timeout → tries SEARCH_PROVIDER_SECONDARY (e.g., Bing)
#    - If results < SEARCH_MIN_RESULTS_BEFORE_FALLBACK → tries next provider
#    - If all fail → logs "[SEARCH] no provider available"
#
# 3. Trust Scoring:
#    - Results are scored using config/source_trust.yaml
#    - High-trust domains (e.g., reuters.com) get score boost
#    - Results are ranked by combined relevance + trust score
#
# 4. URL-Only Mode:
#    - If user includes URLs directly in prompt, SearchEngine skips providers
#    - URLs are passed directly to fetch_and_extract
#
# -----------------------------------------------------------------------------
# Example Configurations:
# -----------------------------------------------------------------------------
# Brave-first with Bing fallback (recommended):
#   SEARCH_PROVIDER_PRIMARY=brave
#   SEARCH_PROVIDER_SECONDARY=bing
#   SEARCH_PROVIDER_TERTIARY=searxng
#   BRAVE_API_KEY=your-key
#   BING_API_KEY=your-key
#
# Bing-only (simpler setup):
#   SEARCH_PROVIDER_PRIMARY=bing
#   SEARCH_PROVIDER_SECONDARY=searxng
#   BING_API_KEY=your-key
#
# Self-hosted SearXNG only (no external API keys needed):
#   SEARCH_PROVIDER_PRIMARY=searxng
#   SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# For each search, diagnostic logs are output:
#   [SEARCH] providers_tried=brave,bing used=brave langs=it,en results=8 attempts=1 time_ms=450
#   [SEARCH] top_domains=coinmarketcap.com,reuters.com,wikipedia.org
