# ============================================================================
# QuantumDev v5 - Configurazione OTTIMIZZATA per GPU A6000 48GB VRAM
# ============================================================================
# Questa configurazione massimizza le capacità cognitive dell'AI
# sfruttando al massimo la GPU A6000 da 48GB con DeepSeek-R1-Distill-Qwen-32B
#
# ARCHITETTURA:
# - GPU A6000 48GB (Vast.ai) → Inference LLM via tmux tunnel
# - CPU Contabo VPS → Backend, orchestration, web search
#
# IMPORTANTE: Copia questi valori nel tuo .env reale
# ============================================================================

# =============================================================================
# LLM ENDPOINT - CONFIGURAZIONE A6000
# =============================================================================
# Endpoint del tunnel SSH dalla GPU Vast.ai
LLM_ENDPOINT=http://127.0.0.1:5000/v1

# NOTA: Il nome modello nel .env non include l'estensione .gguf
# L'estensione viene gestita automaticamente da text-generation-webui
# Nel comando di avvio del server specificare il nome completo con .gguf
LLM_MODEL=DeepSeek-R1-Distill-Qwen-32B-abliterated-Q6_K

# =============================================================================
# LLM PARAMETERS - OTTIMIZZATI PER 48GB VRAM
# =============================================================================
# Con 48GB puoi aumentare significativamente il context window
# DeepSeek-R1 supporta fino a 128K context, ma 64K è ottimale per velocità

# Context Window - MASSIMIZZATO per A6000
# NOTA: LLM_MAX_CTX è usato da chat_engine.py per il modello LLM
# MAX_CONTEXT_TOKENS è usato da altri componenti (memory, orchestrator)
# Mantengono lo stesso valore per consistenza
LLM_MAX_CTX=65536                # 64K context window (sfrutta la VRAM)
LLM_OUTPUT_BUDGET_TOK=4096       # Output più lunghi per risposte complete
LLM_SAFETY_MARGIN_TOK=1024       # Margine di sicurezza aumentato

# Parametri di generazione ottimizzati
LLM_TEMPERATURE=0.7              # Bilanciato: preciso ma non troppo rigido
LLM_MAX_TOKENS=4096              # Risposte più lunghe e articolate
LLM_TOP_P=0.95                   # Nucleus sampling ottimale
LLM_REPETITION_PENALTY=1.05      # Leggera penalità per evitare ripetizioni
LLM_PRESENCE_PENALTY=0.1         # Incoraggia varietà nei topic

# Timeout e retry - aumentati per modello grande
LLM_HTTP_TIMEOUT_S=180.0         # 3 minuti (modello 32B può richiedere tempo)
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_S=1.0

# =============================================================================
# FEATURE FLAGS - TUTTI ABILITATI PER MASSIMA INTELLIGENZA
# =============================================================================
ENABLE_CONVERSATIONAL_MEMORY=true    # Memoria conversazionale attiva
ENABLE_FUNCTION_CALLING=true         # Function calling per tool use
ENABLE_REASONING_TRACES=true         # Tracce di ragionamento (debug)
ENABLE_ARTIFACTS=true                # Gestione artifacts (codice, file)
ENABLE_PROACTIVE_SUGGESTIONS=true    # Suggerimenti proattivi
ENABLE_STREAMING=1                   # Enable SSE streaming support (POST /chat/stream)

# =============================================================================
# CONTEXT MANAGEMENT - ESTESO PER A6000
# =============================================================================
MAX_CONTEXT_TOKENS=65536         # 64K context disponibili
SLIDING_WINDOW_SIZE=30           # Ultimi 30 turni di conversazione
SUMMARIZATION_THRESHOLD=40       # Summarize dopo 40 turni
SUMMARIZATION_TOKEN_LIMIT=8000   # Max token per riassunti

# =============================================================================
# SESSION PERSISTENCE - MEMORIA A LUNGO TERMINE
# =============================================================================
SESSION_TTL=7776000              # 90 giorni (3 mesi) in secondi
CONVERSATION_TTL_DAYS=90         # 3 mesi di retention conversazioni
PERSIST_ARCHIVE_ENABLED=true     # Archivia sessioni su disco
ARCHIVE_DIR=./data/archive

# =============================================================================
# PERSONAL MEMORY - PROFILO UTENTE AVANZATO
# =============================================================================
USER_PROFILE_ENABLED=1
USER_PROFILE_COLLECTION=user_profile
USER_PROFILE_MAX_AGE_DAYS=3650   # 10 anni (i fatti personali non scadono)
DEFAULT_USER_ID=matteo

# =============================================================================
# EPISODIC MEMORY - MEMORIA EPISODICA ESTESA
# =============================================================================
EPISODIC_MEMORY_ENABLED=1
EPISODIC_MEMORY_COLLECTION=conversation_history
EPISODIC_BUFFER_SIZE=30          # Buffer più grande per context
EPISODIC_BUFFER_TOKEN_LIMIT=8000 # 8K token per buffer episodico
EPISODIC_SUMMARIZE_ENABLED=1
EPISODIC_MAX_AGE_DAYS=365        # 1 anno di ritenzione

# =============================================================================
# MEMORY RETRIEVAL - OTTIMIZZATO
# =============================================================================
MEMORY_PROFILE_TOP_K=15          # Recupera più fatti utente
MEMORY_EPISODIC_TOP_K=10         # Più contesto episodico
MEMORY_MAX_CONTEXT_TOKENS=4000   # Più spazio per memoria nel prompt

# =============================================================================
# REDIS - CACHING E SESSIONI
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CHROMADB - VECTOR MEMORY
# =============================================================================
CHROMA_PERSIST_DIR=/memory/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MEM_HALF_LIFE_D=30.0             # 30 giorni half-life (memoria più persistente)

# =============================================================================
# WEB SEARCH - OTTIMIZZATO PER RICERCA INTELLIGENTE
# =============================================================================
WEB_SEARCH_DEEP_MODE=true        # Ricerca approfondita sempre attiva
WEB_DEEP_MAX_SOURCES=25          # Più fonti per ricerca completa
WEB_SUMMARY_BUDGET_TOK=4000      # Budget sintesi aumentato
WEB_EXTRACT_PER_DOC_TOK=2000     # Più testo per documento
WEB_SUMMARIZE_TOP_DEFAULT=5      # Sintetizza top 5 risultati
WEB_FETCH_TIMEOUT_S=8.0          # Timeout aumentato
WEB_FETCH_MAX_INFLIGHT=10        # Più fetch paralleli
WEB_READ_TIMEOUT_S=12.0          # Timeout lettura pagina
WEB_USE_CONCISE_FORMATTER=true   # Formattazione concisa
WEB_FALLBACK_TO_LLM=true         # Fallback a LLM se web fallisce

# Web Research Agent - Multi-step
WEB_RESEARCH_BUDGET_TOK=4000
WEB_RESEARCH_FETCH_TIMEOUT_S=8.0
WEB_RESEARCH_MAX_DOCS=8
WEB_RESEARCH_MAX_STEPS=4
WEB_RESEARCH_QUALITY_THRESHOLD=0.65
WEB_RESEARCH_MAX_CONCURRENT=6

# =============================================================================
# HTTP CONNECTION POOLING - PERFORMANCE
# =============================================================================
HTTP_POOL_SIZE=100               # Pool connessioni aumentato
HTTP_POOL_PER_HOST=15            # Max per host aumentato
FETCH_TIMEOUT_CONNECT=3.0        # Connection timeout
FETCH_TIMEOUT_READ=10.0          # Read timeout

# =============================================================================
# INTENT CLASSIFICATION - INTELLIGENTE
# =============================================================================
LLM_INTENT_ENABLED=1             # Classificazione intent con LLM
INTENT_LLM_MIN_CONFIDENCE=0.45   # Soglia confidence ridotta per catturare più casi
INTENT_FEEDBACK_ENABLED=true     # Feedback per miglioramento

# =============================================================================
# TOOLS - ABILITATI SELETTIVAMENTE
# =============================================================================
TOOLS_MATH_ENABLED=true          # Calcolatrice avanzata
TOOLS_PYTHON_EXEC_ENABLED=false  # Python exec: DISABILITATO per sicurezza
TOOLS_DOCS_ENABLED=true          # Documenti e PDF
TOOLS_OCR_ENABLED=true           # OCR per immagini
OCR_MAX_IMAGE_SIZE_MB=50         # Immagini più grandi
OCR_DEFAULT_LANG=eng+ita         # Inglese + Italiano

# =============================================================================
# CODE GENERATION - OTTIMIZZATO
# =============================================================================
CODE_AGENT_TIMEOUT=60.0          # Timeout aumentato per codice complesso
CODE_MAX_TOKENS=8192             # Codice più lungo
CODE_EXEC_TIMEOUT=30             # Execution timeout
CODE_EXEC_ENABLED=0              # Disabilitato per sicurezza (abilita con =1)

# =============================================================================
# RERANKER & DIVERSIFIER - QUALITÀ RISULTATI
# =============================================================================
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu              # Reranker su CPU (GPU per LLM principale)
DIVERSIFIER_ENABLED=true

# =============================================================================
# AUTONOMOUS AGENT (ReAct-style Multi-Step Execution)
# =============================================================================
ENABLE_AUTONOMOUS_MODE=1         # Enable autonomous agent endpoint
AUTONOMOUS_MAX_STEPS=10          # Maximum steps per plan
AUTONOMOUS_MAX_RETRIES=3         # Maximum retries per failed step
AUTONOMOUS_REQUIRE_APPROVAL=0    # Set to 1 to require user approval before execution
AUTONOMOUS_MAX_PARALLEL_TOOLS=5  # Maximum parallel tool executions

# =============================================================================
# CACHE TTL - OTTIMIZZATI PER FRESHNESS
# =============================================================================
LIVE_CACHE_TTL_WEATHER=600       # 10 minuti per meteo
LIVE_CACHE_TTL_PRICE=15          # 15 secondi per prezzi (real-time)
LIVE_CACHE_TTL_SPORTS=120        # 2 minuti per sport
LIVE_CACHE_TTL_NEWS=180          # 3 minuti per news
LIVE_CACHE_TTL_SCHEDULE=900      # 15 minuti per orari
LIVE_AGENT_TIMEOUT_S=20.0        # Timeout agent aumentato

# =============================================================================
# MULTI-LEVEL CACHE
# =============================================================================
ENABLE_L1_CACHE=1                # L1 in-memory cache
L1_CACHE_SIZE=500                # 500 items (aumentato)
L1_CACHE_TTL=600                 # 10 minuti TTL
ENABLE_L2_CACHE=1                # L2 Redis semantic cache

# =============================================================================
# REASONING & DEBUG
# =============================================================================
VERBOSE_REASONING=false          # Disabilitato in produzione
LOG_LEVEL=INFO                   # INFO in produzione, DEBUG per sviluppo

# =============================================================================
# TELEGRAM (opzionale)
# =============================================================================
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_ADMIN_ID=your_chat_id_here

# =============================================================================
# SECURITY
# =============================================================================
# QUANTUM_SHARED_SECRET=your_secret_here

# =============================================================================
# GPU MONITORING & ALERTING - Remote A6000 48GB on Vast.ai
# =============================================================================
# GPU Monitoring Mode: auto (try remote first, fallback to local), local, remote, disabled
GPU_MONITORING_MODE=remote

# SSH Connection to GPU Node (Vast.ai)
GPU_SSH_HOST=localhost           # Or Vast.ai SSH host if not using tunnel
GPU_SSH_PORT=22                  # SSH port (22 for direct, or tunnel port)
GPU_SSH_USER=root                # SSH username (usually root on Vast.ai)
GPU_SSH_KEY_PATH=                # Path to SSH private key (leave empty to use password)
GPU_SSH_PASSWORD=                # SSH password (use key auth preferred)
GPU_SSH_TIMEOUT=10               # SSH connection timeout in seconds

# Metrics Caching
GPU_METRICS_CACHE_TTL=10         # Cache metrics for 10 seconds
GPU_BACKGROUND_UPDATE_INTERVAL=30  # Background update every 30 seconds

# Alert Thresholds
GPU_ALERT_ENABLED=1                      # Enable GPU alerting system
GPU_ALERT_VRAM_WARNING=90                # VRAM warning threshold (%)
GPU_ALERT_VRAM_CRITICAL=95               # VRAM critical threshold (%)
GPU_ALERT_TEMP_WARNING=80                # Temperature warning threshold (°C)
GPU_ALERT_TEMP_CRITICAL=85               # Temperature critical threshold (°C)
GPU_ALERT_OFFLINE_CRITICAL_MINUTES=5     # Alert if GPU offline for N minutes

# Alert Duration Thresholds (before triggering alert)
GPU_ALERT_VRAM_WARNING_DURATION=120      # VRAM warning must persist for 2 minutes
GPU_ALERT_VRAM_CRITICAL_DURATION=30      # VRAM critical must persist for 30 seconds

# Alert Rate Limiting & History
GPU_ALERT_CHECK_INTERVAL=60              # Check GPU metrics every 60 seconds
GPU_ALERT_RATE_LIMIT_SECONDS=900         # Max 1 alert per condition per 15 minutes
GPU_ALERT_HISTORY_TTL_DAYS=7             # Keep alert history for 7 days in Redis

# Telegram Alerts (requires TELEGRAM_BOT_TOKEN and TELEGRAM_ADMIN_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=                  # Admin chat ID for GPU alerts

# AutoBug GPU Check
AUTOBUG_ENABLE_GPU=1                     # Enable GPU health check in autobug
AUTOBUG_GPU_TIMEOUT_S=10.0               # GPU check timeout

# =============================================================================
# GPU OPTIMIZATION FLAGS (per text-generation-webui)
# =============================================================================
# Questi vanno passati nel comando di avvio del server LLM su Vast.ai:
#
# ./start_linux.sh --listen --api --api-port 5000 \
#   --model DeepSeek-R1-Distill-Qwen-32B-abliterated-Q6_K.gguf \
#   --loader llama.cpp \
#   --n-gpu-layers 100 \
#   --n_ctx 65536 \
#   --threads 8 \
#   --threads_batch 8 \
#   --flash-attn \
#   --mlock
#
# NOTE:
# - flash-attn: Accelera attention (richiede GPU supportata)
# - mlock: Blocca modello in RAM per evitare swap
# - threads: Numero thread CPU per operazioni non-GPU
# ============================================================================

# =============================================================================
# KNOWLEDGE GRAPH - LAYER SEMANTICO SU CHROMADB
# =============================================================================
# Knowledge Graph layer aggiunge tracking delle relazioni tra concetti
# Usa NetworkX in-memory + persistenza GraphML + spaCy per NLP

# Abilita/disabilita knowledge graph
ENABLE_KNOWLEDGE_GRAPH=1

# Soglia di similarità semantica per inferire relazioni automatiche
# Valori: 0.0-1.0 (default: 0.6 = relazioni moderatamente forti)
KG_SIMILARITY_THRESHOLD=0.6

# Path di persistenza del grafo (formato GraphML XML)
KG_PERSIST_PATH=./data/knowledge_graph.graphml

# Limiti per evitare crescita eccessiva
KG_MAX_NODES=10000              # Massimo numero di concetti nel grafo
KG_MAX_EDGES_PER_NODE=50        # Massimo numero di relazioni per concetto

# Modello spaCy per estrazione concetti
# Opzioni: en_core_web_sm (veloce), en_core_web_lg (accurato), it_core_news_sm (italiano)
# NOTA: Richiede download: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# Lunghezza minima/massima per concetti validi
MIN_CONCEPT_LENGTH=2
MAX_CONCEPT_LENGTH=100

# ============================================================================
