# ============================================================================
# QuantumDev v4 - Configurazione Ottimizzata per Massima Intelligenza
# ============================================================================
# Questa configurazione massimizza le capacità cognitive dell'AI
# con memoria estesa, ragionamento profondo e zero filtri inutili.
#
# IMPORTANTE: Questo file è un esempio. Copia i valori nel tuo .env reale.
# ============================================================================

# =============================================================================
# LLM ENDPOINT - RICHIESTO
# =============================================================================
# Specifica il tuo endpoint LLM (obbligatorio)
LLM_ENDPOINT=http://127.0.0.1:5000/v1
# TUNNEL_ENDPOINT=https://your-tunnel.trycloudflare.com  # Se usi tunnel

# =============================================================================
# LLM CONFIGURATION - OTTIMIZZATO v4
# =============================================================================
LLM_MODEL=qwen2.5-32b-awq
LLM_TEMPERATURE=0.75      # Leggermente più creativo (0.0-1.0)
LLM_MAX_TOKENS=2048       # Risposte più lunghe e complete
LLM_MAX_CTX=32768         # 32K context window
LLM_OUTPUT_BUDGET_TOK=2048
LLM_SAFETY_MARGIN_TOK=512

# =============================================================================
# FEATURE FLAGS - TUTTI ABILITATI
# =============================================================================
ENABLE_CONVERSATIONAL_MEMORY=true
ENABLE_FUNCTION_CALLING=true
ENABLE_REASONING_TRACES=true
ENABLE_ARTIFACTS=true
ENABLE_PROACTIVE_SUGGESTIONS=true

# =============================================================================
# CONTEXT MANAGEMENT - ESTESO
# =============================================================================
MAX_CONTEXT_TOKENS=65536        # 64K context window
SLIDING_WINDOW_SIZE=20          # Ultimi 20 turni visibili
SUMMARIZATION_THRESHOLD=30      # Summarize dopo 30 turni
SUMMARIZATION_TOKEN_LIMIT=4000  # Più spazio per riassunti

# =============================================================================
# SESSION PERSISTENCE - ESTESA
# =============================================================================
SESSION_TTL=2592000             # 30 giorni (in secondi)
CONVERSATION_TTL_DAYS=30        # Mantieni conversazioni per 30 giorni
PERSIST_ARCHIVE_ENABLED=true    # Archivia sessioni su disco
ARCHIVE_DIR=./data/archive

# =============================================================================
# PERSONAL MEMORY - PROFILO UTENTE
# =============================================================================
USER_PROFILE_ENABLED=1
USER_PROFILE_COLLECTION=user_profile
USER_PROFILE_MAX_AGE_DAYS=3650  # 10 anni (i fatti personali non scadono)
DEFAULT_USER_ID=matteo

# =============================================================================
# PERSONAL MEMORY - MEMORIA EPISODICA
# =============================================================================
EPISODIC_MEMORY_ENABLED=1
EPISODIC_MEMORY_COLLECTION=conversation_history
EPISODIC_BUFFER_SIZE=20         # Buffer più grande
EPISODIC_BUFFER_TOKEN_LIMIT=4000
EPISODIC_SUMMARIZE_ENABLED=1
EPISODIC_MAX_AGE_DAYS=365       # 1 anno di ritenzione

# =============================================================================
# MEMORY RETRIEVAL - OTTIMIZZATO
# =============================================================================
MEMORY_PROFILE_TOP_K=10         # Recupera più fatti
MEMORY_EPISODIC_TOP_K=5         # Recupera più contesto
MEMORY_MAX_CONTEXT_TOKENS=2000  # Più contesto memoria

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CHROMADB
# =============================================================================
CHROMA_PERSIST_DIR=/memory/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MEM_HALF_LIFE_D=14.0            # 14 giorni half-life (memoria più persistente)

# =============================================================================
# WEB SEARCH - OTTIMIZZATO
# =============================================================================
WEB_SEARCH_DEEP_MODE=true       # Ricerca approfondita abilitata
WEB_DEEP_MAX_SOURCES=20         # Più fonti
WEB_SUMMARY_BUDGET_TOK=2000     # Budget aumentato
WEB_EXTRACT_PER_DOC_TOK=1000
WEB_SUMMARIZE_TOP_DEFAULT=3
WEB_FETCH_TIMEOUT_S=5.0
WEB_FETCH_MAX_INFLIGHT=6
WEB_READ_TIMEOUT_S=8.0
WEB_USE_CONCISE_FORMATTER=true
WEB_FALLBACK_TO_LLM=true

# =============================================================================
# WEB SEARCH - HTTP CONNECTION POOLING (Phase 2)
# =============================================================================
HTTP_POOL_SIZE=50               # Total connection pool size
HTTP_POOL_PER_HOST=10           # Max connections per host
FETCH_TIMEOUT_CONNECT=2.0       # Connection timeout (seconds)
FETCH_TIMEOUT_READ=6.0          # Read timeout (seconds)

# =============================================================================
# WEB SEARCH - ASYNC PARALLELIZATION (Phase 1)
# =============================================================================
HTTP_MAX_CONCURRENT=6           # Max concurrent HTTP requests
HTTP_RATE_LIMIT_PER_DOMAIN=2.0  # Max requests per second per domain
HTTP_MAX_RETRIES=3              # Max retries with exponential backoff
HTTP_BACKOFF_BASE=0.5           # Base backoff time (seconds)
HTTP_BACKOFF_MAX=10.0           # Max backoff time (seconds)

# =============================================================================
# INTENT CLASSIFICATION
# =============================================================================
LLM_INTENT_ENABLED=1            # Usa LLM per classificazione intent
INTENT_LLM_MIN_CONFIDENCE=0.50
INTENT_FEEDBACK_ENABLED=true

# =============================================================================
# TOOLS - TUTTI ABILITATI
# =============================================================================
TOOLS_MATH_ENABLED=true
TOOLS_PYTHON_EXEC_ENABLED=false  # Mantieni false per sicurezza
TOOLS_DOCS_ENABLED=true
TOOLS_OCR_ENABLED=true
OCR_MAX_IMAGE_SIZE_MB=20
OCR_DEFAULT_LANG=eng+ita

# =============================================================================
# RERANKER & DIVERSIFIER
# =============================================================================
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
DIVERSIFIER_ENABLED=true

# =============================================================================
# AUTONOMOUS AGENT (ReAct-style Multi-Step Execution)
# =============================================================================
ENABLE_AUTONOMOUS_MODE=1         # Enable autonomous agent endpoint
AUTONOMOUS_MAX_STEPS=10          # Maximum steps per plan
AUTONOMOUS_MAX_RETRIES=3         # Maximum retries per failed step
AUTONOMOUS_REQUIRE_APPROVAL=0    # Set to 1 to require user approval before execution
AUTONOMOUS_MAX_PARALLEL_TOOLS=5  # Maximum parallel tool executions

# =============================================================================
# CACHE TTL
# =============================================================================
LIVE_CACHE_TTL_WEATHER=1800
LIVE_CACHE_TTL_PRICE=30         # Più reattivo per prezzi
LIVE_CACHE_TTL_SPORTS=180
LIVE_CACHE_TTL_NEWS=300
LIVE_CACHE_TTL_SCHEDULE=1800
LIVE_AGENT_TIMEOUT_S=15.0

# =============================================================================
# MULTI-LEVEL CACHE (Phase 2)
# =============================================================================
ENABLE_L1_CACHE=1               # Enable L1 in-memory cache
L1_CACHE_SIZE=100               # L1 cache size (items)
L1_CACHE_TTL=300                # L1 cache TTL (seconds, default 5 minutes)
ENABLE_L2_CACHE=1               # Enable L2 Redis semantic cache

# =============================================================================
# TELEGRAM (opzionale)
# =============================================================================
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# =============================================================================
# ADMIN
# =============================================================================
# QUANTUM_SHARED_SECRET=your_secret_here
