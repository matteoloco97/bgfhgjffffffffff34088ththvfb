# ============================================================================
# QuantumDev - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================================================

# =============================================================================
# LLM ENDPOINT - REQUIRED
# =============================================================================
# Your LLM API endpoint (OpenAI-compatible)
LLM_ENDPOINT=http://127.0.0.1:5000/v1
# TUNNEL_ENDPOINT=https://your-tunnel.example.com  # If using SSH tunnel/Cloudflare

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7           # Creativity level (0.0-1.0)
LLM_MAX_TOKENS=2048           # Max response length
LLM_MAX_CTX=32768             # Context window size
LLM_OUTPUT_BUDGET_TOK=2048    # Token budget for output
LLM_SAFETY_MARGIN_TOK=512     # Safety margin for context

# =============================================================================
# API KEYS
# =============================================================================
# OpenAI API Key (if using OpenAI directly)
# OPENAI_API_KEY=sk-...

# Brave Search API Key (for web search)
# BRAVE_API_KEY=your-brave-api-key

# Telegram Bot Token (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CONVERSATIONAL_MEMORY=true
ENABLE_FUNCTION_CALLING=true
ENABLE_REASONING_TRACES=true
ENABLE_ARTIFACTS=true
ENABLE_PROACTIVE_SUGGESTIONS=true

# =============================================================================
# CONTEXT MANAGEMENT
# =============================================================================
MAX_CONTEXT_TOKENS=32768          # Maximum context window
SLIDING_WINDOW_SIZE=20            # Number of recent turns to keep
SUMMARIZATION_THRESHOLD=30        # Summarize after N turns
SUMMARIZATION_TOKEN_LIMIT=4000    # Max tokens for summaries

# =============================================================================
# SESSION PERSISTENCE
# =============================================================================
SESSION_TTL=86400                 # Session TTL in seconds (24 hours)
CONVERSATION_TTL_DAYS=7           # Keep conversations for N days
PERSIST_ARCHIVE_ENABLED=true      # Archive sessions to disk
ARCHIVE_DIR=./data/archive        # Archive directory path

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# ChromaDB (Vector Database)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=quantumdev

# =============================================================================
# WEB SEARCH CONFIGURATION
# =============================================================================
BRAVE_SEARCH_ENABLED=true
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT=30                 # Timeout in seconds
WEB_SCRAPING_TIMEOUT=10          # Timeout for scraping individual pages
MAX_PARALLEL_REQUESTS=5          # Max concurrent web requests

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600                   # Cache TTL in seconds (1 hour)
CACHE_MAX_SIZE=1000              # Max cache entries

# =============================================================================
# GPU MONITORING (Optional)
# =============================================================================
# GPU_MONITORING_ENABLED=false
# GPU_SSH_HOST=your-gpu-host.com
# GPU_SSH_PORT=22
# GPU_SSH_USER=root
# GPU_SSH_KEY_PATH=~/.ssh/id_rsa

# =============================================================================
# SECURITY
# =============================================================================
# API authentication (if needed)
# API_KEY=your-api-key
# JWT_SECRET=your-jwt-secret

# Admin token for bypassing rate limits
# Generate a secure random token (e.g., openssl rand -hex 32)
ADMIN_TOKEN=your-secure-admin-token-here

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100      # Max requests per window
RATE_LIMIT_WINDOW_SECONDS=60     # Time window in seconds

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/quantumdev.log
LOG_MAX_BYTES=10485760          # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# TELEGRAM BOT (Optional)
# =============================================================================
# TELEGRAM_ENABLED=false
# TELEGRAM_STREAMING_ENABLED=true
# TELEGRAM_MAX_MESSAGE_LENGTH=4096

# =============================================================================
# CODE EXECUTION (Sandbox)
# =============================================================================
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT=30        # Timeout in seconds
CODE_EXECUTION_MAX_OUTPUT=10000  # Max output characters

# =============================================================================
# OCR CONFIGURATION (Optional)
# =============================================================================
# OCR_ENABLED=false
# TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# KNOWLEDGE GRAPH
# =============================================================================
KNOWLEDGE_GRAPH_ENABLED=true
KG_MAX_ENTITIES=1000
KG_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
MAX_WORKERS=4                    # Thread pool size
ASYNC_TIMEOUT=60                 # Async operation timeout
REQUEST_TIMEOUT=30               # HTTP request timeout

# === PARALLEL SYNTHESIS (STEP 1.2) ===
# Parallel document synthesis for web search results
# Reduces synthesis time from 10-15s (sequential) to 3-5s (parallel)
PARALLEL_SYNTHESIS_ENABLED=1           # Enable/disable parallel synthesis (1=enabled, 0=disabled)
PARALLEL_SYNTHESIS_MAX_CONCURRENT=3    # Maximum concurrent document syntheses
PARALLEL_SYNTHESIS_TIMEOUT=5.0         # Timeout per document in seconds
PARALLEL_SYNTHESIS_TOKEN_LIMIT=80      # Maximum tokens per document synthesis
PARALLEL_SYNTHESIS_RETRY_ATTEMPTS=2    # Maximum retry attempts for failed syntheses

# =============================================================================
# DEVELOPMENT
# =============================================================================
DEBUG=false
RELOAD=false                     # Auto-reload on code changes
