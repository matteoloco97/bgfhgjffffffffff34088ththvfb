# ============================================================================
# QuantumDev - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================================================

# =============================================================================
# LLM ENDPOINT - REQUIRED
# =============================================================================
# Your LLM API endpoint (OpenAI-compatible)
# Type: string (URL format)
LLM_ENDPOINT=http://127.0.0.1:5000/v1

# Tunnel endpoint for remote access (optional)
# Type: string (URL format)
# TUNNEL_ENDPOINT=https://your-tunnel.example.com  # If using SSH tunnel/Cloudflare

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Model name to use
# Type: string
LLM_MODEL=gpt-4

# Creativity level (0.0-1.0)
# Type: float (range: 0.0-1.0)
LLM_TEMPERATURE=0.7

# Max response length in tokens
# Type: integer
LLM_MAX_TOKENS=2048

# Context window size in tokens
# Type: integer
LLM_MAX_CTX=32768

# Token budget for output
# Type: integer
LLM_OUTPUT_BUDGET_TOK=2048

# Safety margin for context
# Type: integer
LLM_SAFETY_MARGIN_TOK=512

# =============================================================================
# API KEYS
# =============================================================================
# OpenAI API Key (if using OpenAI directly)
# Type: string (format: sk-...)
# OPENAI_API_KEY=sk-...

# Brave Search API Key (for web search)
# Type: string
# BRAVE_API_KEY=your-brave-api-key

# Telegram Bot Token (optional)
# Type: string (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# Get from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your-bot-token

# AWS Credentials (for S3, SQS, or other AWS services)
# Type: string
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Type: boolean (true/false)
ENABLE_CONVERSATIONAL_MEMORY=true
ENABLE_FUNCTION_CALLING=true
ENABLE_REASONING_TRACES=true
ENABLE_ARTIFACTS=true
ENABLE_PROACTIVE_SUGGESTIONS=true

# =============================================================================
# CONTEXT MANAGEMENT
# =============================================================================
MAX_CONTEXT_TOKENS=32768          # Maximum context window
SLIDING_WINDOW_SIZE=20            # Number of recent turns to keep
SUMMARIZATION_THRESHOLD=30        # Summarize after N turns
SUMMARIZATION_TOKEN_LIMIT=4000    # Max tokens for summaries

# =============================================================================
# SESSION PERSISTENCE
# =============================================================================
SESSION_TTL=86400                 # Session TTL in seconds (24 hours)
CONVERSATION_TTL_DAYS=7           # Keep conversations for N days
PERSIST_ARCHIVE_ENABLED=true      # Archive sessions to disk
ARCHIVE_DIR=./data/archive        # Archive directory path

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Redis connection details
# Type: string (hostname or IP)
REDIS_HOST=localhost

# Type: integer (port number)
REDIS_PORT=6379

# Type: integer (database number, 0-15)
REDIS_DB=0

# Redis password (if authentication enabled)
# Type: string
# REDIS_PASSWORD=your-redis-password

# ChromaDB (Vector Database)
# Type: string (path)
CHROMA_PERSIST_DIR=./data/chroma

# Type: string
CHROMA_COLLECTION_NAME=quantumdev

# =============================================================================
# WEB SEARCH CONFIGURATION
# =============================================================================
BRAVE_SEARCH_ENABLED=true
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT=30                 # Timeout in seconds
WEB_SCRAPING_TIMEOUT=10          # Timeout for scraping individual pages
MAX_PARALLEL_REQUESTS=5          # Max concurrent web requests

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600                   # Cache TTL in seconds (1 hour)
CACHE_MAX_SIZE=1000              # Max cache entries

# =============================================================================
# GPU MONITORING (Optional)
# =============================================================================
# GPU_MONITORING_ENABLED=false
# GPU_SSH_HOST=your-gpu-host.com
# GPU_SSH_PORT=22
# GPU_SSH_USER=root
# GPU_SSH_KEY_PATH=~/.ssh/id_rsa

# =============================================================================
# SECURITY
# =============================================================================
# ENCRYPTION KEY for secrets management (REQUIRED for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Type: string (base64-encoded 32-byte key)
# Store this securely - DO NOT commit to git!
ENCRYPTION_KEY=your-fernet-encryption-key-here

# API authentication (if needed)
# Type: string
# API_KEY=your-api-key

# JWT Secret for token signing
# Type: string (minimum 32 characters recommended)
# JWT_SECRET=your-jwt-secret

# Admin token for bypassing rate limits
# Generate a secure random token (e.g., openssl rand -hex 32)
# Type: string (hex-encoded, 64+ characters recommended)
ADMIN_TOKEN=your-secure-admin-token-here

# Shared secret for inter-service authentication
# Type: string
QUANTUM_SHARED_SECRET=your-quantum-shared-secret

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100      # Max requests per window
RATE_LIMIT_WINDOW_SECONDS=60     # Time window in seconds

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/quantumdev.log
LOG_MAX_BYTES=10485760          # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# TELEGRAM BOT (Optional)
# =============================================================================
# TELEGRAM_ENABLED=false
# TELEGRAM_STREAMING_ENABLED=true
# TELEGRAM_MAX_MESSAGE_LENGTH=4096

# =============================================================================
# CODE EXECUTION (Sandbox)
# =============================================================================
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT=30        # Timeout in seconds
CODE_EXECUTION_MAX_OUTPUT=10000  # Max output characters

# =============================================================================
# OCR CONFIGURATION (Optional)
# =============================================================================
# OCR_ENABLED=false
# TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# WEB INTERFACE CONFIGURATION
# =============================================================================
# Modern ChatGPT/Claude-like web interface settings
WEB_INTERFACE_ENABLED=true
WEB_INTERFACE_TITLE=QuantumDev AI
WEB_INTERFACE_SUBTITLE=Il tuo assistente AI personale senza censura

# Streaming responses
STREAMING_ENABLED=true
STREAMING_CHUNK_SIZE=256           # Characters per chunk for streaming

# File upload settings
FILE_UPLOAD_ENABLED=true
FILE_UPLOAD_MAX_SIZE=10485760     # 10MB in bytes
FILE_UPLOAD_ALLOWED_EXTENSIONS=.pdf,.txt,.doc,.docx,.jpg,.jpeg,.png,.gif

# Conversation settings
CONVERSATION_MAX_HISTORY=50        # Max messages to keep in conversation
CONVERSATION_AUTO_SAVE=true        # Auto-save conversations to localStorage

# =============================================================================
# KNOWLEDGE GRAPH
# =============================================================================
KNOWLEDGE_GRAPH_ENABLED=true
KG_MAX_ENTITIES=1000
KG_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
MAX_WORKERS=4                    # Thread pool size
ASYNC_TIMEOUT=60                 # Async operation timeout
REQUEST_TIMEOUT=30               # HTTP request timeout

# === PARALLEL SYNTHESIS (STEP 1.2) ===
# Parallel document synthesis for web search results
# Reduces synthesis time from 10-15s (sequential) to 3-5s (parallel)
PARALLEL_SYNTHESIS_ENABLED=1           # Enable/disable parallel synthesis (1=enabled, 0=disabled)
PARALLEL_SYNTHESIS_MAX_CONCURRENT=3    # Maximum concurrent document syntheses
PARALLEL_SYNTHESIS_TIMEOUT=5.0         # Timeout per document in seconds
PARALLEL_SYNTHESIS_TOKEN_LIMIT=80      # Maximum tokens per document synthesis
PARALLEL_SYNTHESIS_RETRY_ATTEMPTS=2    # Maximum retry attempts for failed syntheses

# =============================================================================
# AUTO WEB SEARCH INTELLIGENCE (STEP 2)
# =============================================================================
# Main toggle for auto-search feature
AUTO_SEARCH_ENABLED=true
AUTO_SEARCH_CONFIDENCE_THRESHOLD=0.7

# Temporal detection settings
AUTO_SEARCH_TEMPORAL_ENABLED=true
AUTO_SEARCH_TEMPORAL_KEYWORDS=oggi,adesso,ora,now,current,recente,latest

# Live data detection settings
AUTO_SEARCH_LIVE_DATA_ENABLED=true
AUTO_SEARCH_LIVE_DATA_TYPES=price,weather,news,sports
AUTO_SEARCH_LIVE_ENTITIES=BTC,ETH,Bitcoin,Ethereum

# Knowledge gap detection
AUTO_SEARCH_KNOWLEDGE_GAP_ENABLED=true
AUTO_SEARCH_GAP_MIN_CONFIDENCE=0.6

# Search strategy timeouts (seconds)
AUTO_SEARCH_QUICK_TIMEOUT=10
AUTO_SEARCH_DEEP_TIMEOUT=30
AUTO_SEARCH_RESEARCH_TIMEOUT=60

# Cache policies for live data (TTL in seconds)
CACHE_POLICY_PRICE=60              # 1 minute for price data
CACHE_POLICY_WEATHER=1800          # 30 minutes for weather
CACHE_POLICY_NEWS=600              # 10 minutes for news
CACHE_POLICY_SPORTS=300            # 5 minutes for sports
CACHE_POLICY_SCHEDULE=600          # 10 minutes for schedules

# Synthesis modes token limits
SYNTHESIS_CONCISE_MAX_TOKENS=100
SYNTHESIS_DETAILED_MAX_TOKENS=300
SYNTHESIS_COMPREHENSIVE_MAX_TOKENS=800

# Intent classification
INTENT_CLASSIFIER_ENABLED=true
INTENT_CLASSIFIER_MODEL=lightweight  # 'lightweight' for patterns, 'llm' for LLM-based
INTENT_CONFIDENCE_MIN=0.6

# =============================================================================
# DEVELOPMENT
# =============================================================================
DEBUG=false
RELOAD=false                     # Auto-reload on code changes
